# Период парсинга. Меняется вручную раз в полгода при смене семестра,
# после чего контейнер пересобирается/перезапускается.
PARSING_YEAR=2025-2026
PARSING_SEMESTER=0

# Логирование: DEBUG / INFO / WARNING / ERROR (легаси-алиас DEV = INFO)
LOG_LEVEL=INFO

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB_0=0
REDIS_DB_1=1
REDIS_META_DB=2

# Планировщик
SCHEDULER_INTERVAL_MINUTES=30
