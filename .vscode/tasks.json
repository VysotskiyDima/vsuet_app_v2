{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-redis-debug",
      "type": "shell",
      "command": "docker start vsuet_rating_v2-redis-DEBUG 2>/dev/null || docker run -d --name vsuet_rating_v2-redis-DEBUG -p 6379:6379 -v vsuet_rating_v2-redis-DEBUG-data:/data redis:7-alpine redis-server --save 60 1 --dbfilename dump.rdb --dir /data",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "clear-redis-debug",
      "type": "shell",
      "command": "docker exec vsuet_rating_v2-redis-DEBUG sh -c \"until redis-cli ping | grep -q PONG; do sleep 0.1; done && redis-cli flushall\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "start-redis-debug-clear",
      "dependsOrder": "sequence",
      "dependsOn": [
        "start-redis-debug",
        "clear-redis-debug"
      ],
      "problemMatcher": []
    },
    {
      "label": "stop-redis-debug",
      "type": "shell",
      "command": "docker stop vsuet_rating_v2-redis-DEBUG 2>/dev/null || true",
      "problemMatcher": []
    },
    {
      "label": "start-frontend",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m http.server -d front 3000",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving HTTP on",
          "endsPattern": "Serving HTTP on"
        }
      }
    },
    {
      "label": "wait-for-redis",
      "type": "shell",
      "command": "docker exec vsuet_rating_v2-redis-DEBUG sh -c \"until redis-cli ping | grep -q PONG; do sleep 0.1; done\"",
      "problemMatcher": []
    },
    {
      "label": "start-all-debug-services",
      "dependsOrder": "sequence",
      "dependsOn": [
        "start-redis-debug",
        "wait-for-redis",
        "start-frontend"
      ],
      "problemMatcher": []
    }
  ]
}
