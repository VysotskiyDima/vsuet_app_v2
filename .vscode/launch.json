{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1) FastAPI (docker) + Redis (existing)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "pathMappings": [
        { "localRoot": "${workspaceFolder}/app", "remoteRoot": "/app/app" }
      ],
      "justMyCode": false,
      "preLaunchTask": "debug: app + existing redis"
