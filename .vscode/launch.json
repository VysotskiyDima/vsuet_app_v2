{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rating",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "console": "integratedTerminal",
      "env": {
        "PARSING_YEAR": "2025-2026",
        "PARSING_SEMESTER": "0",
        "DB_PATH": "data/rating.sqlite3"
      },
      "preLaunchTask": "prepare-backend",
      "postDebugTask": "cleanup-backend"
    },
    {
      "name": "Rating (Clear DB)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "console": "integratedTerminal",
      "env": {
        "PARSING_YEAR": "2025-2026",
        "PARSING_SEMESTER": "0",
        "DB_PATH": "data/rating.sqlite3"
      },
      "preLaunchTask": "prepare-backend-clear",
      "postDebugTask": "cleanup-backend"
    },
    {
      "name": "Rating (Local Fullstack)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "console": "integratedTerminal",
      "env": {
        "PARSING_YEAR": "2025-2026",
        "PARSING_SEMESTER": "0",
        "DB_PATH": "data/rating.sqlite3"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Uvicorn running on",
        "uriFormat": "http://localhost:3000"
      },
      "preLaunchTask": "prepare-fullstack",
      "postDebugTask": "cleanup-fullstack"
    }
  ]
}
