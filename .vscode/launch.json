{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI (local + Redis в контейнере)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "preLaunchTask": "start-redis-debug",
      "postDebugTask": "stop-redis-debug",
      "env": {
        "REDIS_HOST": "localhost",
        "REDIS_PORT": "6379",
        "PARSING_YEAR": "2025-2026",
        "PARSING_SEMESTER": "0"
      }
    }
  ]
}
